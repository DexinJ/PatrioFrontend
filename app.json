{
  "expo": {
    "name": "Pantrio",
    "slug": "pantrio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pantrio",
    "owner": "dexjin",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.chilltech.pantrio",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A8E91"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true,
            "useFrameworks": "static"
          }
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pantrio uses your photo library only for pictures you attach to a chat.",
          "cameraPermission": "Pantrio uses the camera only for pictures you attach to a chat.",
          "microphonePermission": false
        }
      ],
      "expo-status-bar",
      "expo-notifications",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "dexinjin"
        }
      ],
      "expo-secure-store",
      "./plugins/withPrivateCloudComputeEntitlement"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "48e12973-9e82-4257-a473-2e0cd5665bd1"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/48e12973-9e82-4257-a473-2e0cd5665bd1"
    }
  }
}
